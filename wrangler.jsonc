{
  "name": "desartly",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./server/worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "OWNER_RATE_LIMITER",
      "namespace_id": "9161401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "9161402",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DESARTLY_AUTH",
      "id": "dafc5eabe17841f184d67c9f7e6061d7"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desartly-content",
      "database_id": "eb3a1934-e8ed-493b-a0f7-42fd6e16b7cb",
      "migrations_dir": "server/migrations"
    }
  ],
  "vars": {
    "S3_ENDPOINT": "https://c237873.parspack.net",
    "S3_BUCKET": "c237873",
    "S3_REGION": "us-east-1"
  }
}
