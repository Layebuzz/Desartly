ndex:-2;background:url('/projects/afc-qatar/stadium.webp') center 51%/cover}.hero:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#10080fe8 0%,#190d1490 48%,#100a1010 75%),linear-gradient(0deg,#101014,transparent 55%)}.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#ed91ad;margin-right:9px}.hero h1{font-size:clamp(76px,11.5vw,164px);letter-spacing:-.02em;margin:26px 0 25px;max-width:750px}.hero h1 em{font-style:normal;color:#edb4c4}.hero p{max-width:330px;color:#e3d5db;font-size:13px}.primary{background:#f5e9e9;color:#4d1124;display:inline-flex;align-items:center;justify-content:space-between;gap:35px;padding:15px 21px;border:0;border-radius:3px;font-weight:800;font-size:12px;min-height:48px}.hero .primary{margin-top:28px}.primary:hover{background:#f2adc1;transform:translateY(-2px)}.hero-foot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:58px}.partner{display:flex;align-items:center;gap:13px}.partner small{max-width:72px;line-height:1.4;color:#c8bbc3;font-size:9px;letter-spacing:1px;text-transform:uppercase}.partner img{width:113px;background:#fff;border-radius:3px;padding:5px 8px}.stamp{font-family:'Barlow Condensed',sans-serif;text-align:right;font-size:22px;line-height:1.1}.stamp small{display:block;font:9px Manrope;letter-spacing:2px;margin-top:8px}.ticker{background:#8e1638;padding:18px 4%;display:flex;justify-content:space-between;gap:24px;white-space:nowrap;overflow:hidden;font:700 24px 'Barlow Condensed';letter-spacing:1px}.ticker span:nth-child(2n){color:#e8a9bc}.matches{padding:55px 5% 50px;background:#151518}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.section-head h2{font-size:48px;letter-spacing:-.5px}.section-head p{color:#b6b0b4;font-size:11px}.tabs{display:flex;gap:8px;margin-bottom:23px;flex-wrap:wrap}.tabs button{border:1px solid #ffffff2b;border-radius:30px;background:transparent;color:#dad1d5;padding:10px 18px;font-size:11px;min-height:44px}.tabs button[aria-pressed=true]{background:#eedade;color:#491226;border-color:#eedade}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.match{border:1px solid #ffffff26;border-radius:4px;padding:23px 21px;background:#1c1b20;transition:transform .25s,border-color .25s}.match:hover{transform:translateY(-5px);border-color:#ce809a}.match small{font-size:9px;letter-spacing:1.2px;color:#c7b9c0}.teams{display:flex;align-items:center;justify-content:space-between;margin:22px 0;font-family:'Barlow Condensed';font-size:35px}.teams i{font:10px Manrope;color:#b9a9b1}.flag{width:30px;height:20px;display:inline-block;margin-right:6px;vertical-align:3px;border-radius:2px}.qat{background:linear-gradient(90deg,#fff 25%,#8e1638 25%)}.irn{background:linear-gradient(#23935d 33%,white 33%,white 66%,#d43a42 66%)}.jpn{background:radial-gradient(circle,#c52844 30%,transparent 33%),white}.kor{background:radial-gradient(circle at 50% 42%,#ca354d 23%,transparent 25%),radial-gradient(circle at 50% 62%,#2660a4 23%,transparent 25%),white}.aus{background:#153d83}.jor{background:linear-gradient(#222 33%,white 33%,white 66%,#308554 66%)}.match p{font-size:11px;color:#c7b9c0}.match button{display:flex;width:100%;align-items:center;justify-content:space-between;margin-top:24px;background:none;border:0;border-top:1px solid #ffffff20;padding:17px 0 0;color:#f2c8d6;min-height:44px;font-weight:700;font-size:12px}.match button:hover{color:white}.closing{background:#efe9e1;color:#46162a;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:55px 5%;gap:55px}.closing h2{font-size:68px;letter-spacing:-1px}.closing p{max-width:360px;font-size:12px;line-height:1.9}.closing a{display:inline-block;margin-top:18px;border-bottom:1px solid;padding:10px 0;font-weight:800;font-size:11px}.foot{padding:18px 5%;display:flex;justify-content:space-between;font-size:9px;letter-spacing:1px;color:#c6b7c0}.hidden{display:none!important}dialog{background:#f5f1eb;color:#321323;border:0;border-radius:10px;padding:30px;width:min(90vw,450px)}dialog::backdrop{background:#100910bc;backdrop-filter:blur(6px)}dialog h2{font-size:48px;margin:15px 0}dialog p{font-size:13px;margin-bottom:20px}dialog .primary{background:#8e1638;color:white;width:100%}.close{float:right;background:none;border:0;min-width:44px;min-height:44px;font-size:24px}.demo-label{font-size:10px;color:#977985}.ticket-lines{border-top:1px dashed #b7a3a9;border-bottom:1px dashed #b7a3a9;padding:15px 0;margin-bottom:20px;display:flex;justify-content:space-between}\n@media(max-width:650px){nav{height:76px}.navlinks{display:none}.hero{padding-top:65px;min-height:660px}.hero h1{font-size:86px;max-width:390px}.hero:before{background-position:65% center}.hero:after{background:linear-gradient(90deg,#10080fe8,#190d1440),linear-gradient(0deg,#101014,transparent 60%)}.hero-foot{margin-top:60px}.stamp{font-size:18px}.cards{grid-template-columns:1fr}.match{padding:20px}.teams{margin:15px 0}.section-head{align-items:start;flex-direction:column}.section-head h2{font-size:45px}.closing{grid-template-columns:1fr;gap:25px}.closing h2{font-size:60px}.foot{gap:20px;line-height:1.7}.ticker{font-size:21px}.matches{padding-top:42px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}\n</style></head><body><nav><a class=\"brand\" href=\"#top\"><img src=\"/projects/afc-qatar/afc-logo.webp\" alt=\"AFC Asian Cup Qatar 2023\"><span>AFC ASIAN CUP<br>QATAR 2023™</span></a><div class=\"navlinks\"><a href=\"#matches\">The matches</a><a href=\"#experience\">The experience</a></div><a class=\"outline eyebrow\" href=\"#matches\">Find your ticket ↗</a></nav><main><section class=\"hero\" id=\"top\"><div class=\"eyebrow\"><span class=\"dot\"></span>One continent. One stage.</div><h1>BE THERE.<br><em>FEEL IT ALL.</em></h1><p>The noise. The nerves. The ninety minutes.<br>Your place in Asia’s biggest football story.</p><a class=\"primary\" href=\"#matches\">Explore match tickets <span>↗</span></a><div class=\"hero-foot\"><div class=\"partner\"><small>Project<br>via</small><img src=\"/projects/afc-qatar/flightio-logo.webp\" alt=\"Flightio\"></div><div class=\"stamp\">24 TEAMS. ONE DREAM.<small>QATAR / ASIAN CUP 2023</small></div></div></section><div class=\"ticker\" aria-hidden=\"true\"><span>THIS IS YOUR MOMENT</span><span>✦</span><span>LIVE IT FROM THE STANDS</span><span>✦</span><span>THIS IS YOUR MOMENT</span></div><section class=\"matches\" id=\"matches\"><div class=\"section-head\"><div><p class=\"eyebrow\" style=\"margin-bottom:16px\">01 / Pick your match</p><h2>YOUR TEAM. YOUR TICKET.</h2></div><p>Interactive concept · illustrative fixtures & prices</p></div><div class=\"tabs\" aria-label=\"Filter matches\"><button data-filter=\"all\" aria-pressed=\"true\">All matches</button><button data-filter=\"qatar\" aria-pressed=\"false\">Qatar</button><button data-filter=\"iran\" aria-pressed=\"false\">Iran</button><button data-filter=\"japan\" aria-pressed=\"false\">Japan</button></div><div class=\"cards\"><article class=\"match\" data-team=\"qatar\"><small>SPOTLIGHT / MATCH 01</small><div class=\"teams\"><span><b class=\"flag qat\"></b>QAT</span><i>VS</i><span>JOR <b class=\"flag jor\"></b></span></div><p>Lusail Stadium · Evening session</p><button data-match=\"Qatar × Jordan\" data-price=\"150\">From QAR 150 <span>Get tickets ↗</span></button></article><article class=\"match\" data-team=\"iran\"><small>SPOTLIGHT / MATCH 02</small><div class=\"teams\"><span><b class=\"flag irn\"></b>IRN</span><i>VS</i><span>KOR <b class=\"flag kor\"></b></span></div><p>Education City · Evening session</p><button data-match=\"Iran × Korea Republic\" data-price=\"90\">From QAR 90 <span>Get tickets ↗</span></button></article><article class=\"match\" data-team=\"japan\"><small>SPOTLIGHT / MATCH 03</small><div class=\"teams\"><span><b class=\"flag jpn\"></b>JPN</span><i>VS</i><span>AUS <b class=\"flag aus\"></b></span></div><p>Al Janoub Stadium · Afternoon session</p><button data-match=\"Japan × Australia\" data-price=\"90\">From QAR 90 <span>Get tickets ↗</span></button></article></div></section><section class=\"closing\" id=\"experience\"><h2>NOT JUST A MATCH.<br>A MEMORY.</h2><div><p>Follow your team all the way to the stands. A clear route from the match you love to the seat you want, with Flightio as the project intermediary.</p><a href=\"#matches\">Find your moment ↗</a></div></section></main><footer class=\"foot\"><span>AFC QATAR / LANDING PAGE DESIGN STUDY</span><span>DESIGN BY ALI KOMEILI · PROJECT VIA FLIGHTIO</span></footer><dialog aria-labelledby=\"dialog-title\"><button class=\"close\" aria-label=\"Close ticket preview\">×</button><span class=\"eyebrow\">Your match ticket</span><h2 id=\"dialog-title\">QATAR × JORDAN</h2><div class=\"ticket-lines\"><span>Category 3 · 1 guest</span><strong id=\"price\">QAR 150</strong></div><p>This prototype demonstrates the booking entry point. Seat selection is explored in the interaction study below.</p><button class=\"primary\" id=\"done\">Back to matches <span>↗</span></button><p class=\"demo-label\" style=\"margin-top:16px;margin-bottom:0\">Design preview. No payment or reservation is made.</p></dialog><script>\nconst dialog=document.querySelector('dialog');document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-filter]').forEach(t=>t.setAttribute('aria-pressed',t===b));document.querySelectorAll('[data-team]').forEach(c=>c.classList.toggle('hidden',b.dataset.filter!=='all'&&b.dataset.filter!==c.dataset.team));size()});document.querySelectorAll('[data-match]').forEach(b=>b.onclick=()=>{document.querySelector('#dialog-title').textContent=b.dataset.match;document.querySelector('#price').textContent='QAR '+b.dataset.price;dialog.showModal()});document.querySelector('.close').onclick=document.querySelector('#done').onclick=()=>dialog.close();function size(){parent.postMessage({type:'desartly:preview-size',height:document.documentElement.scrollHeight},'*')}new ResizeObserver(size).observe(document.body);window.addEventListener('load',size);\n</script></body></html>\n"
    },
    {
      "id": "afc-chapter-02",
      "type": "text",
      "layout": "chapter",
      "chapter": "02 / THE DETAILS",
      "title": "Make every choice feel immediate.",
      "text": "The experience responds to intent: selecting a stand updates the ticket, adding a guest recalculates the total, and following a team changes the saved state. The same controls work with a mouse, touch or keyboard."
    },
