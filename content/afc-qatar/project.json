 U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}*{box-sizing:border-box}body{margin:0;font:13px/1.6 Manrope,Arial,sans-serif;color:#261a21;background:#eee9e2}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;line-height:.95}button{font:inherit;cursor:pointer;transition:background .2s,transform .2s;min-height:44px}button:focus-visible{outline:3px solid #8e1638;outline-offset:4px}.wrap{padding:55px 5%}.kicker{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:700}.head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin:18px 0 36px}.head h1{font-size:60px}.head p{max-width:260px;font-size:12px;color:#71646b}.grid{display:grid;grid-template-columns:1.15fr 1fr;gap:22px}.seat-panel{background:#fffaf5;border:1px solid #d8cdd0;border-radius:8px;padding:28px}.panelhead{display:flex;justify-content:space-between;font-size:10px;letter-spacing:1px}.stadium{height:280px;position:relative;margin:22px 0}.pitch{position:absolute;inset:75px 28%;background:#668b64;border:3px solid white;outline:1px solid #688563;display:flex;align-items:center;justify-content:center;color:white;font-size:9px;letter-spacing:1px}.pitch:before{content:'';position:absolute;top:0;bottom:0;left:50%;border-left:1px solid #ffffff99}.pitch:after{content:'';position:absolute;border:1px solid #ffffff99;border-radius:50%;width:44px;height:44px}.zone{position:absolute;border:0;background:#e0b6c3;color:#4e182d;border-radius:12px;font-size:11px;font-weight:800}.zone:hover,.zone[aria-pressed=true]{background:#8e1638;color:white}.zone.north{top:8px;left:24%;right:24%;height:55px;border-radius:65% 65% 8px 8px}.zone.south{bottom:8px;left:24%;right:24%;height:55px;border-radius:8px 8px 65% 65%}.zone.west{left:5%;top:70px;bottom:70px;width:19%;border-radius:65% 8px 8px 65%}.zone.east{right:5%;top:70px;bottom:70px;width:19%;border-radius:8px 65% 65% 8px}.legend{display:flex;justify-content:center;gap:18px;color:#6e5963;font-size:10px}.legend span:before{content:'';width:7px;height:7px;display:inline-block;border-radius:2px;background:#e0b6c3;margin-right:6px}.legend span:last-child:before{background:#8e1638}.hint{margin-top:22px;padding-top:18px;border-top:1px solid #e6dbe0;font-size:11px;color:#735965}.ticket-stage{padding:22px;background:#871938;border-radius:8px;display:flex;align-items:center;justify-content:center;perspective:1000px;overflow:hidden}.ticket{background:#fff7ec;width:100%;max-width:330px;box-shadow:0 22px 45px #37041866;border-radius:10px;transform:rotate(3deg);transition:transform .3s;overflow:hidden}.ticket-stage:hover .ticket{transform:rotate(0deg) translateY(-4px)}.ticket-top{padding:28px}.ticket .kicker{color:#78515d;font-size:9px}.ticket h2{font-size:52px;margin:18px 0 23px}.ticket-data{display:flex;justify-content:space-between;border-top:1px solid #dfcbd0;padding-top:15px}.ticket-data small{display:block;font-size:9px;color:#78515d}.ticket-data strong{font-size:12px}.ticket-bottom{border-top:1px dashed #b79ca6;position:relative;padding:22px 28px}.ticket-bottom:before,.ticket-bottom:after{content:'';position:absolute;top:-10px;width:20px;height:20px;border-radius:50%;background:#871938}.ticket-bottom:before{left:-10px}.ticket-bottom:after{right:-10px}.qty{display:flex;align-items:center;justify-content:space-between}.stepper{display:flex;align-items:center;gap:10px}.stepper button{border:1px solid #c8aeb7;background:transparent;border-radius:50%;width:44px;height:44px;font-size:22px}.stepper button:disabled{opacity:.35;cursor:not-allowed}.total{display:flex;justify-content:space-between;align-items:center;margin:16px 0}.total strong{font-family:'Barlow Condensed';font-size:34px}.book{border:0;background:#8e1638;color:white;width:100%;padding:13px;border-radius:3px;font-weight:800;font-size:12px}.book:hover{background:#5e132b}.barcode{height:26px;margin-top:18px;background:repeating-linear-gradient(90deg,#3a1a28 0px,#3a1a28 2px,transparent 2px,transparent 5px,#3a1a28 5px,#3a1a28 6px,transparent 6px,transparent 10px);opacity:.8}.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:35px;margin-top:32px}.notes b{font-family:'Barlow Condensed';font-size:27px;display:block;margin-bottom:7px}.notes p{font-size:11px;color:#6b5a63}.progress{height:3px;margin-top:15px;background:#ffffff35;border-radius:10px;overflow:hidden}.progress i{height:100%;display:block;background:#eec3d1;width:33%;transition:width .3s}.banner{margin-top:24px;background:#18151a;color:#eadfe4;padding:25px 30px;border-radius:5px;display:flex;align-items:center;justify-content:space-between;gap:28px}.banner h3{font-size:30px}.banner p{font-size:11px;color:#c9b8c0;margin-top:8px}.banner button{background:#f0d4de;border:0;color:#4f1c30;border-radius:30px;padding:10px 25px;font-size:12px}.banner button[aria-pressed=true]{background:#c8e1c5;color:#173c20}.state{font-size:10px;color:#784a5b;margin-top:12px;min-height:32px}.footnote{font-size:10px;color:#786a71;margin-top:25px}@media(max-width:650px){.wrap{padding:35px 5%}.head{flex-direction:column;align-items:start;gap:18px}.head h1{font-size:49px}.grid{grid-template-columns:1fr}.seat-panel{padding:20px}.stadium{height:260px}.ticket-stage{padding:30px}.notes{grid-template-columns:1fr;gap:22px}.banner{align-items:start;flex-direction:column}.banner button{width:100%}.notes b{font-size:24px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}.ticket{transform:none!important}}\n</style></head><body><main class=\"wrap\"><p class=\"kicker\">02 / The interaction lab</p><div class=\"head\"><h1>SMALL DETAILS.<br>BIG MATCH ENERGY.</h1><p>Tap a stand. Change the guest count.<br>Watch your ticket respond.</p></div><div class=\"grid\"><section class=\"seat-panel\" aria-label=\"Stadium seat categories\"><div class=\"panelhead\"><strong>LUSAIL / SEATING STUDY</strong><span>01 — SELECT</span></div><div class=\"stadium\"><div class=\"pitch\" aria-label=\"Football pitch\"><span>PITCH</span></div><button class=\"zone north\" data-zone=\"North stand\" data-price=\"90\" aria-pressed=\"false\">NORTH · 90</button><button class=\"zone west\" data-zone=\"West stand\" data-price=\"150\" aria-pressed=\"true\">WEST<br>150</button><button class=\"zone east\" data-zone=\"East stand\" data-price=\"150\" aria-pressed=\"false\">EAST<br>150</button><button class=\"zone south\" data-zone=\"South stand\" data-price=\"90\" aria-pressed=\"false\">SOUTH · 90</button></div><div class=\"legend\"><span>Available category</span><span>Your selection</span></div><p class=\"hint\">A spatial choice, with the price in plain sight.<br>Diagram and QAR prices are illustrative.</p></section><section class=\"ticket-stage\" aria-label=\"Responsive ticket preview\"><div class=\"ticket\"><div class=\"ticket-top\"><p class=\"kicker\">AFC ASIAN CUP / QATAR 2023</p><h2>QATAR<br><span style=\"color:#a68490;font-size:26px\">VERSUS</span> JORDAN</h2><div class=\"ticket-data\"><div><small>STADIUM</small><strong>Lusail</strong></div><div><small>STAND</small><strong id=\"stand\">West stand</strong></div></div></div><div class=\"ticket-bottom\"><div class=\"qty\"><span>Guests</span><div class=\"stepper\"><button id=\"minus\" aria-label=\"Remove guest\" disabled>−</button><strong id=\"quantity\">1</strong><button id=\"plus\" aria-label=\"Add guest\">+</button></div></div><div class=\"total\" aria-live=\"polite\"><span>Total · QAR</span><strong id=\"total\">150</strong></div><button class=\"book\" id=\"preview\">Preview my ticket ↗</button><p class=\"state\" id=\"status\" role=\"status\">Choose a stand to shape your matchday.</p><div class=\"barcode\" aria-hidden=\"true\"></div></div></div></section></div><div class=\"notes\"><div><b>01 / Spatial feedback</b><p>The selected stand and the ticket stay in sync. Hover hints become tap states on mobile.</p></div><div><b>02 / An honest total</b><p>Every guest changes the price immediately. No hidden calculation at the next step.</p></div><div><b>03 / A ticket with character</b><p>A perforated edge, soft tilt and barcode turn a transaction into a keepsake.</p></div></div><section class=\"banner\"><div><p class=\"kicker\">A little anticipation</p><h3>FOLLOW THE FEELING.</h3><p id=\"follow-copy\" role=\"status\">Save Qatar in this preview to personalise your matchday.</p></div><button id=\"follow\" aria-pressed=\"false\">Follow Qatar +</button></section><p class=\"footnote\">Interactive design prototype · no real bookings, live availability or payments.</p></main><script>\nlet count=1,price=150,stand='West stand';const q=id=>document.getElementById(id);function update(){q('stand').textContent=stand;q('quantity').textContent=count;q('total').textContent=count*price;q('minus').disabled=count===1;q('plus').disabled=count===6;q('status').textContent='Choose a stand to shape your matchday.';q('preview').textContent='Preview my ticket ↗'}document.querySelectorAll('.zone').forEach(b=>b.onclick=()=>{stand=b.dataset.zone;price=Number(b.dataset.price);document.querySelectorAll('.zone').forEach(t=>t.setAttribute('aria-pressed',t===b));update()});q('minus').onclick=()=>{count=Math.max(1,count-1);update()};q('plus').onclick=()=>{count=Math.min(6,count+1);update()};q('preview').onclick=()=>{q('status').textContent=`Preview ready: ${count} ${count===1?'guest':'guests'}, ${stand}, QAR ${count*price}. No reservation made.`;q('preview').textContent='Ticket preview ready ✓'};q('follow').onclick=()=>{const on=q('follow').getAttribute('aria-pressed')!=='true';q('follow').setAttribute('aria-pressed',on);q('follow').textContent=on?'Following Qatar ✓':'Follow Qatar +';q('follow-copy').textContent=on?'Qatar saved for this preview. Your next match starts here.':'Save Qatar in this preview to personalise your matchday.'};function size(){parent.postMessage({type:'desartly:preview-size',height:document.documentElement.scrollHeight},'*')}new ResizeObserver(size).observe(document.body);window.addEventListener('load',size);\n</script></body></html>\n"
    },
    {
      "id": "afc-chapter-03",
      "type": "text",
      "layout": "chapter",
      "chapter": "03 / THE PROCESS",
      "title": "A simple structure beneath the spectacle.",
      "text": "The journey starts with a single invitation, narrows into a match choice and finishes with a visible ticket summary. This reconstructed sketch makes the hierarchy and mobile decisions explicit."
    },
