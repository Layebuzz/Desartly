      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n@font-face {\n  font-family: 'Barlow Condensed';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(/projects/afc-qatar/barlow-condensed-700.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Barlow Condensed';\n  font-style: normal;\n  font-weight: 900;\n  font-display: swap;\n  src: url(/projects/afc-qatar/barlow-condensed-900.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Caveat';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(/projects/afc-qatar/caveat-600.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n@font-face {\n  font-family: 'Manrope';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(/projects/afc-qatar/manrope-400.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}*{box-sizing:border-box}body{margin:0;background:#f6f2e8;color:#463c39;font:13px/1.6 Manrope,sans-serif}.board{padding:48px 5% 38px;background-image:radial-gradient(#a9977b40 .8px,transparent .8px);background-size:18px 18px}.top{display:flex;justify-content:space-between;align-items:center;gap:25px}.top small{font-size:10px;letter-spacing:2px}.top h1{font:700 48px Caveat,cursive;margin:7px 0 20px}.top p{font:24px Caveat,cursive;color:#9b3457;transform:rotate(-4deg)}svg{display:block;width:100%;height:auto}text{font-family:Caveat,cursive;fill:#51463e;font-size:22px}.line{fill:none;stroke:#65564c;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.light{stroke:#9d8d7e;stroke-width:1.2;fill:none}.accent{fill:none;stroke:#a83a5c;stroke-width:2;stroke-linecap:round}.red{fill:#9b3457}.foot{border-top:1px solid #d8cbbb;display:flex;justify-content:space-between;gap:25px;padding-top:20px;font-size:11px;color:#74665b}@media(max-width:650px){.top{display:block}.top h1{font-size:38px}.top p{font-size:22px;transform:none}.canvas{overflow-x:auto;padding-bottom:15px}.canvas svg{min-width:700px}.foot{flex-direction:column;gap:8px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n</style></head><body><section class=\"board\"><div class=\"top\"><div><small>03 / BEFORE THE POLISH</small><h1>First the journey. Then the roar.</h1></div><p>One primary action per moment.<br>Keep the fan moving ↙</p></div><div class=\"canvas\" tabindex=\"0\" role=\"region\" aria-label=\"Sketch wireframe board; scroll horizontally on small screens\"><svg viewBox=\"0 0 1080 660\" role=\"img\" aria-label=\"Sketch of desktop landing, mobile ticket flow and booking decision notes\"><defs><pattern id=\"hatch\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(35)\"><path d=\"M0 0V10\" stroke=\"#b5a697\" stroke-width=\"1\"/></pattern></defs><g transform=\"rotate(-1 330 290)\"><path class=\"line\" d=\"M60 30L597 35L592 586L54 580Z\"/><path class=\"light\" d=\"M58 63L595 68M60 60L594 64\"/><circle cx=\"74\" cy=\"48\" r=\"3\" fill=\"#988779\"/><circle cx=\"86\" cy=\"48\" r=\"3\" fill=\"#988779\"/><circle cx=\"98\" cy=\"49\" r=\"3\" fill=\"#988779\"/><text x=\"249\" y=\"54\" font-size=\"15\">THE LANDING PAGE</text><path class=\"line\" d=\"M74 87L109 87L109 120L75 120Z\"/><text x=\"125\" y=\"110\">AFC</text><path class=\"light\" d=\"M338 102L380 103M398 103L440 104\"/><path class=\"line\" d=\"M461 87L577 90L575 116L460 117Z\"/><text x=\"475\" y=\"109\" font-size=\"17\">Find tickets ↗</text><path fill=\"url(#hatch)\" stroke=\"#a39484\" d=\"M75 141L573 145L574 316L75 313Z\"/><path fill=\"#f6f2e8\" d=\"M84 150H343V300H84Z\"/><text x=\"94\" y=\"194\" style=\"font-size:40px;font-weight:700\">BE THERE.</text><text x=\"94\" y=\"231\" style=\"font-size:40px;font-weight:700\">FEEL IT ALL.</text><path class=\"light\" d=\"M96 248L263 250M96 258L215 259\"/><path class=\"accent\" d=\"M94 272L247 274L246 300L94 298Z\"/><text x=\"105\" y=\"294\" font-size=\"18\" class=\"red\">Explore tickets →</text><circle class=\"line\" cx=\"445\" cy=\"190\" r=\"19\"/><path class=\"line\" d=\"M433 210L415 259L476 260L459 210M419 257L413 301M466 259L487 301M427 219L397 251M460 218L491 240\"/><path class=\"accent\" d=\"M77 330Q300 336 573 335\"/><text x=\"80\" y=\"369\" font-size=\"29\">YOUR TEAM. YOUR TICKET.</text><path class=\"line\" d=\"M78 386L147 387L146 407L78 406M166 389L211 390M231 390L278 391M299 391L349 392\"/><path class=\"line\" d=\"M76 425L229 427L228 535L75 533ZM245 427L397 428L396 536L245 535ZM415 429L570 430L568 536L415 536Z\"/><text x=\"99\" y=\"458\">QAT × JOR</text><text x=\"270\" y=\"459\">IRN × KOR</text><text x=\"438\" y=\"460\">JPN × AUS</text><path class=\"light\" d=\"M92 480L204 481M261 482L375 483M431 483L552 484\"/><text x=\"94\" y=\"515\" font-size=\"18\">QAR 150 →</text><text x=\"262\" y=\"516\" font-size=\"18\">QAR 90 →</text><text x=\"432\" y=\"517\" font-size=\"18\">QAR 90 →</text><text x=\"207\" y=\"565\" font-size=\"19\">match → stand → ticket</text></g><g transform=\"rotate(2 810 275)\"><path class=\"line\" d=\"M733 79Q723 80 723 94L720 445Q720 460 738 461L907 464Q924 465 925 449L928 96Q928 81 911 81Z\"/><path class=\"light\" d=\"M728 99L921 101M721 437L923 440\"/><path class=\"line\" d=\"M789 90L858 91\"/><text x=\"748\" y=\"130\" font-size=\"17\">← YOUR MATCH</text><text x=\"745\" y=\"172\" font-size=\"32\">QATAR × JORDAN</text><ellipse class=\"line\" cx=\"823\" cy=\"248\" rx=\"76\" ry=\"52\"/><ellipse class=\"light\" cx=\"823\" cy=\"248\" rx=\"62\" ry=\"40\"/><path class=\"line\" d=\"M789 224L856 225L856 274L789 273ZM822 225V272\"/><path class=\"accent\" d=\"M760 226Q743 249 760 270L774 263Q765 247 775 233Z\"/><text x=\"746\" y=\"330\" font-size=\"20\">West stand     −  1  +</text><path class=\"light\" d=\"M746 344L904 346\"/><text x=\"746\" y=\"372\" font-size=\"22\">Total              QAR 150</text><path class=\"accent\" d=\"M742 388L904 390L904 419L742 418Z\"/><text x=\"762\" y=\"410\" class=\"red\" font-size=\"20\">Preview ticket ↗</text></g><path class=\"accent\" d=\"M686 146Q659 118 587 173M587 173L602 153M587 173L610 172\"/><text x=\"631\" y=\"19\" class=\"red\" transform=\"rotate(-5 631 19)\">1. Emotion first</text><text x=\"639\" y=\"44\" class=\"red\" font-size=\"19\">one hero, one clear CTA</text><path class=\"accent\" d=\"M638 369Q650 429 575 469M575 469L595 449M575 469L599 468\"/><text x=\"608\" y=\"333\" class=\"red\" font-size=\"19\">2. Team filters</text><path class=\"accent\" d=\"M942 314Q988 351 929 403M929 403L952 396M929 403L936 381\"/><text x=\"767\" y=\"511\" class=\"red\" font-size=\"24\">3. Keep the total visible</text><text x=\"767\" y=\"539\" font-size=\"20\">selection + feedback in one view</text><path class=\"accent\" d=\"M749 551Q837 560 992 551\"/><text x=\"74\" y=\"625\" font-size=\"20\">Desktop → anticipation & discovery</text><text x=\"729\" y=\"612\" font-size=\"20\">Mobile → focus & confidence</text></svg></div><div class=\"foot\"><span>WORKING NOTES / STRUCTURE BEFORE SURFACE</span><span>Reconstructed wireframe study · AFC Qatar / Flightio</span></div></section><script>function size(){parent.postMessage({type:'desartly:preview-size',height:document.documentElement.scrollHeight},'*')}new ResizeObserver(size).observe(document.body);window.addEventListener('load',size)</script></body></html>\n"
