      "destination": "https://desartly.layebuzz.workers.dev/api/media/:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend?__route=/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/backend?__route=/mcp"
    },
    {
      "source": "/studio/:surfacePath*",
      "destination": "/api/public?__path=/studio/:surfacePath*"
    },
    {
      "source": "/preview/:surfacePath*",
      "destination": "/api/public?__path=/preview/:surfacePath*"
    },
    {
      "source": "/login",
      "destination": "/api/public?__path=/login"
    },
    {
      "source": "/admin",
      "destination": "/api/public?__path=/admin"
    },
    {
      "source": "/edit/:surfacePath*",
      "destination": "/api/public?__path=/edit/:surfacePath*"
    },
    {
      "source": "/:surfacePath*",
      "destination": "/api/public?__path=/:surfacePath*"
    }
  ],
  "headers": [
    {
      "source": "/studio/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/preview/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/public.js": {
      "includeFiles": "dist/{shell.html,studio-app/index.html}",
      "excludeFiles": "public/**"
    },
    "api/backend.js": {
      "excludeFiles": "public/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.desartly.info/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.desartly.info/:path*",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/journal/:slug",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/about#resume",
      "permanent": true
    }
  ]
}
